# S3-compatible object storage configuration (Neo.id NOS)
S3_ENDPOINT=https://nos.jkt-1.neo.id
S3_REGION=jkt-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=your-bucket-name
# Optional key prefix inside the bucket, e.g. "tmpfup/" (must end with a slash if set)
S3_PREFIX=tmpfup/

# Default + max expiry, in seconds (default 3600 = 1 hour, max 172800 = 48 hours)
DEFAULT_EXPIRE_SECONDS=3600
MAX_EXPIRE_SECONDS=172800

# Max upload size per file, in bytes (default 53687091200 = 50 GiB).
# Uploads are streamed to a local scratch dir then multipart-uploaded to
# S3 (see UPLOAD_TMP_DIR below) - memory usage stays flat regardless of
# this limit, but make sure the VPS disk has enough free space for
# whatever the largest concurrent upload(s) could be.
MAX_FILE_SIZE_BYTES=53687091200

# Scratch directory for in-flight uploads before they're streamed to S3.
# Defaults to a subfolder under the OS temp dir if unset. Point this at a
# larger/faster disk if the default volume doesn't have enough free space
# for very large uploads.
# UPLOAD_TMP_DIR=/opt/tmpfup-backend/tmp-uploads

# Backend HTTP port
PORT=3001

# How often (ms) the background cleanup job scans for expired files
CLEANUP_INTERVAL_MS=60000

# SQLite database file path (stores upload metadata + expiry)
DB_PATH=./data/uploads.sqlite

# Comma-separated list of origins allowed to call this API (CORS).
# Use "*" to allow any origin (fine for a public anonymous upload tool).
CORS_ORIGIN=*

# ── Admin panel ──────────────────────────────────────────────────────────
# NODE_ENV=production enables secure (HTTPS-only) admin session cookies.
NODE_ENV=production

# Long random secret used to sign admin session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this value invalidates all existing admin sessions.
ADMIN_JWT_SECRET=change-me-to-a-long-random-value

# Bootstrap credentials for the FIRST admin account. Only used once, when
# the admin_users table is empty (i.e. the very first time the server ever
# starts). After that, change the password from inside the admin panel -
# these env vars are ignored from then on.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-boot
